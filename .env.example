# Flask configuration
SECRET_KEY=your_secret_key_here # Flask app secret key
FLASK_HOST=127.0.0.1 # Host IP to bind the Flask web application
FLASK_PORT=5000 # Host port to bind the Flask web application
SESSION_TIMEOUT=21600 # Session duration before auto-logout (in seconds)
LOG_LEVEL=INFO # Logging level (DEBUG, INFO, WARNING, ERROR)

# Risk Management parameters
MAX_DAILY_LOSS=10000.0 # Platform-wide circuit breaker maximum daily loss threshold in INR (₹)
MAX_ORDER_VALUE=50000.0 # Circuit breaker maximum allowed margin/value per individual order in INR (₹)
AUTO_LOGOUT_TIME=15:30 # Market close time (IST 24-hr format) to auto-halt and close position books

# Kotak Neo API Credentials (required for LIVE trading mode)
MOBILE_NUMBER=919999999999 # Registered mobile number with country code (e.g., 91 for India)
UCC=UCC123456 # Kotak Neo Client ID / User Code Client (UCC)
MPIN=123456 # Registered 6-digit secure MPIN
CONSUMER_KEY=your_kotak_consumer_key_here # Consumer Key generated from Kotak Developer Portal
CONSUMER_SECRET=your_kotak_consumer_secret_here # Consumer Secret generated from Kotak Developer Portal
API_PASSWORD=your_kotak_api_password_here # API login password registered on the Kotak Neo platform
